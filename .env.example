# Telegram bot token from @BotFather
BOT_TOKEN=

# Source (wholesale) channel: private invite link, needs bot as admin
# Get channel ID by forwarding a message from the channel to @userinfobot,
# or by watching bot logs on any incoming update
SOURCE_CHANNEL_ID=

# Destination (retail) channel: e.g. -1001234567890 for @kshop_cloth
DEST_CHANNEL_ID=

# Comma-separated list of admin user IDs (from @userinfobot)
ADMIN_USER_IDS=52364246

# Path to SQLite database (relative to project root)
DB_PATH=data/bot.db

# CBR daily rate URL (default is fine)
CBR_RATE_URL=https://www.cbr-xml-daily.ru/daily_json.js

# Log level
LOG_LEVEL=INFO
